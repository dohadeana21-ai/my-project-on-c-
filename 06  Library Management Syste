int main() {
    vector<Book> books;
    vector<Member> members;

    int choice;

    do {
        cout << "\n=== Library Management System ===" << endl;
        cout << "1. Books" << endl;
        cout << "2. Members" << endl;
        cout << "3. Exit" << endl;

        choice = print();

        if (choice == 1) {
            do {
                cout << "\n=== Books Menu ===" << endl;
                cout << "1. Add Book" << endl;
                cout << "2. Remove Book" << endl;
                cout << "3. Borrow Book" << endl;
                cout << "4. Return Book" << endl;
                cout << "5. Search Book" << endl;
                cout << "6. Display All Books" << endl;
                cout << "7. Back to Main Menu" << endl;

                choice = print();

                if (choice == 1) {
                    addBook(books);
                }
                else if (choice == 2) {
                    removeBook(books);
                }
                else if (choice == 3) {
                    borrowBook(books, members);
                }
                else if (choice == 4) {
                    returnBook(books, members);
                }
                else if (choice == 5) {
                    searchBook(books);
                }
                else if (choice == 6) {
                    displayAllBooks(books);
                }
                else if (choice != 7) {
                    setColor(12);
                    cout << "Error! Please choose an option from 1 to 7." << endl;
                    setColor(7);
                }

            } while (choice != 7);
        }
        
        else if (choice == 2) {
            do {
                cout << "\n=== Members Menu ===" << endl;
                cout << "1. Add Member" << endl;
                cout << "2. Remove Member" << endl;
                cout << "3. Search Member" << endl;
                cout << "4. Display All Members" << endl;
                cout << "5. Back to Main Menu" << endl;

                choice = print();

                if (choice == 1) {
                    addMember(members);
                }
                else if (choice == 2) {
                    removeMember(members);
                }
                else if (choice == 3) {
                    searchMember(members);
                }
                else if (choice == 4) {
                    displayMember(members);
                }
                else if (choice != 5) {
                    setColor(12);
                    cout << "Error! Please choose an option from 1 to 5." << endl;
                    setColor(7);
                }

            } while (choice != 5);
        }

        else if (choice != 3) {
            setColor(12);
            cout << "Error! Please choose an option from 1 to 3." << endl;
            setColor(7);
        }

    } while (choice != 3);

    setColor(10);
    cout << "Goodbye!" << endl;
    setColor(7);

    return 0;
}
