    // لو البحث باسم المؤلف
    if (searchByAuthor == true) {
        cout << "Enter which book title: ";
        getline(cin, title);

        found = false;

        for (int i = 0; i < books.size(); i++) {
            if (books[i].getTitle() == title &&
                books[i].getAuthor() == search) {

                found = true;
                books[i].displayBook();
                return;
            }
        }

        if (found == false) {
            setColor(12);
            cout << "Book \"" << title
                 << "\" does not exist for this author." << endl;
            setColor(7);
        }
    }
}

